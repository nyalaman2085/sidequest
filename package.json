{
  "name": "new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"VITE_WS_PORT=8788 vite --host 0.0.0.0 --port 4173\" \"PORT=8788 tsx server/index.ts\"",
    "dev:client": "VITE_WS_PORT=8788 vite --host 0.0.0.0 --port 4173",
    "dev:server": "PORT=8788 tsx server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "start:prod": "npm run build && tsx server/index.ts",
    "lint": "oxlint src server",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
