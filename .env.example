# ============================================
# FRONTEND CONFIGURATION (Vite variables)
# ============================================

# WebSocket server URL for signaling
# Development: ws://localhost:8788
# Production: wss://your-domain.com
VITE_WS_URL=ws://localhost:8788

# TURN server for NAT traversal (optional but recommended for production)
# Example: turn:turn.example.com:3478
VITE_TURN_URL=

# TURN server username
VITE_TURN_USERNAME=

# TURN server credential/password
VITE_TURN_CREDENTIAL=

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Node environment (development or production)
NODE_ENV=development

# Server listening port
PORT=8788
